# The URL carries host, port, user, password, and database. The fields below
# it are optional overrides — empty means "not set", and anything filled in
# wins over the URL. Prefer setting the URL alone.
# A jdbc:postgresql://... URL is accepted and converted automatically, as is
# a ?currentSchema=... parameter, which sets the schema below.
# Host Postgres from a container: postgresql://<user>@pghost:5432/summaries
AISUMMRY_DATABASE_URL=postgresql://<user>:<password>@rnd619-nv-prd01:5432/spear
AISUMMRY_DATABASE_USER=
AISUMMRY_DATABASE_PASSWORD=
AISUMMRY_DATABASE_HOST=
AISUMMRY_DATABASE_PORT=
AISUMMRY_DATABASE_NAME=
# Plain identifier owning every table. Empty means the server default (public).
AISUMMRY_DATABASE_SCHEMA=mosaic_magen
AISUMMRY_LLM_MODEL=gemma4:31b-cloud
AISUMMRY_LLM_DIET_MODE=true
AISUMMRY_LLM_TIMEOUT_SECONDS=120
AISUMMRY_LLM_BASE_URL=http://ollama:11434/v1
OPENAI_API_KEY=
AISUMMRY_FLAPI_USERNAME=
AISUMMRY_FLAPI_TOKEN=
AISUMMRY_FLAPI_VERIFY_TLS=true
AISUMMRY_MAX_PARALLEL_WORKFLOWS=4
AISUMMRY_AGENT_MAX_ROUNDS=1
AISUMMRY_PACKAGE_TIMEOUT_SECONDS=120
AISUMMRY_CONVERSATION_IDLE_MINUTES=60
AISUMMRY_CONVERSATION_RETENTION_DAYS=30
AISUMMRY_LOG_RETENTION_DAYS=90
AISUMMRY_ADMIN_PASSWORD=
AISUMMRY_RUNTIME_SETTINGS_FILE=runtime-settings.json
AISUMMRY_REQUEST_LOG_PATH=logs/requests.jsonl
